<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="openbullet_workstation.db" />
        <include domain="file" path="wordlists/" />
        <exclude domain="database" path="openbullet_workstation.db-wal" />
        <exclude domain="database" path="openbullet_workstation.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="openbullet_workstation.db" />
        <include domain="file" path="wordlists/" />
        <exclude domain="database" path="openbullet_workstation.db-wal" />
        <exclude domain="database" path="openbullet_workstation.db-shm" />
    </device-transfer>
</data-extraction-rules>
